#!/bin/bash
# chill-browser — open your default web browser.
#
# niri's `spawn` wants a concrete command, but "the browser" is whatever
# xdg-settings points at — and that is often a flatpak, which has no command
# on PATH at all. Resolving it at run time means switching browsers doesn't
# mean editing keybinds.
#
# Order: $BROWSER, the XDG default desktop entry, an installed browser
# binary, then any flatpak browser.
#
# Any arguments (a URL, --private) are passed straight through.

set -uo pipefail

# NB: no `grep -q`/`-m1` at the end of a pipe anywhere in here — it exits at
# the first match, the writer upstream takes a SIGPIPE, and pipefail reports
# the 141 as failure. sed reads its input to the end and stays honest.

# 1. An explicit choice always wins.
if [[ -n "${BROWSER:-}" ]] && command -v "${BROWSER%% *}" &>/dev/null; then
    # Unquoted on purpose: $BROWSER may carry arguments ("flatpak run com.x").
    # shellcheck disable=SC2086
    exec $BROWSER "$@"
fi

# 2. The XDG default, launched through its desktop entry so flatpaks work.
desktop="$(xdg-settings get default-web-browser 2>/dev/null)" || desktop=""
if [[ -n "$desktop" ]]; then
    if command -v gtk-launch &>/dev/null; then
        exec gtk-launch "$desktop" "$@"
    fi
    # gio wants the file itself, not the entry's id.
    for dir in "$HOME/.local/share/applications" \
               "$HOME/.local/share/flatpak/exports/share/applications" \
               /var/lib/flatpak/exports/share/applications \
               /usr/local/share/applications \
               /usr/share/applications; do
        if [[ -f "$dir/$desktop" ]] && command -v gio &>/dev/null; then
            exec gio launch "$dir/$desktop" "$@"
        fi
    done
fi

# 3. Whatever is installed natively.
for candidate in brave-browser brave chromium chromium-browser google-chrome-stable google-chrome firefox firefox-esr zen-browser; do
    if command -v "$candidate" &>/dev/null; then
        exec "$candidate" "$@"
    fi
done

# 4. Last resort: any flatpak that looks like a browser.
if command -v flatpak &>/dev/null; then
    app="$(flatpak list --app --columns=application 2>/dev/null |
           sed -n '/brave\|chrom\|firefox\|zen\|epiphany/Ip' | sed -n '1p')"
    if [[ -n "$app" ]]; then
        exec flatpak run "$app" "$@"
    fi
fi

echo "chill-browser: no web browser found — set \$BROWSER or install one" >&2
exit 1
